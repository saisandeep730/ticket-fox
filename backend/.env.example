# Local development & production settings — Copy to backend/.env

# API Server
HOST=127.0.0.1
PORT=8000
DEBUG=true

# Database (async driver). SQLite (backend/ticket_fox_web.db) is used when unset.
DATABASE_URL=

# Auth (Firebase Admin). ALLOW_MOCK_AUTH=true accepts demo sign-ins locally.
ALLOW_MOCK_AUTH=true
# Either an inline service-account JSON blob, or a path to the key file.
# In Docker the path is resolved relative to /app, so it must match the bind
# mount target in docker-compose.yml (see the backend service's volumes).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=
SECRET_KEY=change_me_32_chars_min

# CORS Origins (comma-separated origins allowed to make API requests)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Polling Worker (runs inside run.py)
WORKER_ENABLED=true
POLL_INTERVAL_SECONDS=180
WORKER_CONCURRENCY=3
ADMIN_UID=

# Scraper Engine Settings
IMPERSONATE=safari18_0

# Alert Channels ------------------------------------------------------------
# Telegram (user saves their chat id in Settings)
TELEGRAM_BOT_TOKEN=

# Email via Resend
RESEND_API_KEY=
RESEND_FROM=TicketFox <onboarding@resend.dev>

# Per-purpose senders. Resend authorises the DOMAIN, not individual mailboxes, so
# every address below works off the same API key and the same DKIM record — no
# extra DNS verification is needed to add one. Each falls back to RESEND_FROM.
RESEND_ALERTS_FROM=
RESEND_SUPPORT_FROM=
RESEND_GENERAL_FROM=

# Branded auth emails (password reset + email verification). The backend mints
# the Firebase action link and sends its own HTML through Resend. AUTH_EMAIL_FROM
# must be an address on a Resend-verified domain (falls back to RESEND_FROM).
AUTH_EMAIL_FROM=
AUTH_EMAIL_ENABLED=true

# The human-monitored inbox. Alert and auth mail sets this as Reply-To so a user
# who hits "Reply" reaches a person. This is a RECEIVING address: it needs a real
# mailbox (MX + IMAP/webmail). Resend only sends; it cannot receive.
SUPPORT_EMAIL=support@ticketfox.site

# WhatsApp via wppconnect-server (https://github.com/wppconnect-team/wppconnect-server)
# Start the session once (POST /api/<session>/start-session), scan the QR, then
# confirm with GET /api/<session>/status-session. The token is the bcrypt hash
# from POST /api/<session>/<secretkey>/generate-token.
WHATSAPP_API_URL=http://localhost:21465
WHATSAPP_API_TOKEN=
WHATSAPP_SESSION=ticketfox
# "array" for current builds (phone: ["919876543210"]), "string" for older ones
WHATSAPP_PHONE_FORMAT=array

# TMDB API Key for movie posters, backdrops, ratings, synopsis & cast
TMDB_API_KEY=

# Public URL of the web app (used in alert messages)
PUBLIC_APP_URL=http://localhost:3000

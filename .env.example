# Copy to .env and fill in. This file is read by docker-compose only.
# Secrets for the backend live in backend/.env (see backend/.env.example).

# Your public hostname. Must already point (A record) at the VM's IP.
# Caddy obtains a Let's Encrypt certificate for it automatically.
DOMAIN=ticketfox.example.com

# Secret the WhatsApp gateway uses to mint bearer tokens. Generate with
# `openssl rand -hex 24`. This is NOT the token the backend sends — you mint
# that once in step 7 of the deploy guide and put it in backend/.env.
WHATSAPP_SECRET_KEY=change_me_random_hex

# Firebase web config (inlined into the frontend bundle at build time).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin identity (must match ADMIN_UID / ADMIN_EMAIL in backend/.env).
NEXT_PUBLIC_ADMIN_EMAIL=
NEXT_PUBLIC_ADMIN_UID=

# Absolute origin of the public site, e.g. https://ticketfox.example.com
# Used by sitemap.xml, robots.txt and the admin dashboard's "return to app"
# links (the admin subdomain cannot use "/" — middleware rewrites it back to
# /admin). Inlined into the frontend bundle at build time.
NEXT_PUBLIC_SITE_URL=https://ticketfox.example.com

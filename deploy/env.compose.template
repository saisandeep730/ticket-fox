# TicketFox — compose-level environment (copy to ./.env)
#
# Read by docker-compose.yml only. Backend secrets live in backend/.env.
# chmod 600 .env after filling this in.

# Public hostname. Must already resolve (A record) to the instance's public IP.
# Caddy obtains a Let's Encrypt certificate for it automatically.
# DNS: point an A record for the apex at the instance IP and either a second
# A record or a CNAME for www. Caddy validates BOTH, so a www CNAME pointing
# at the registrar's parking page will fail the ACME challenge.
DOMAIN=ticketfox.site

# Optional second hostname served by the same site block — useful for keeping an
# old domain alive during a migration. The `www.` alias of DOMAIN is served
# automatically, so it does not need to be listed here. When unset this defaults
# to DOMAIN (the site list must never end in a dangling comma).
# DOMAIN_ALT=ticketfox.duckdns.org

# Secret the WhatsApp gateway uses to MINT bearer tokens.
# Generate with: openssl rand -hex 24
# This is NOT the token the backend sends — mint that with deploy/whatsapp-link.sh
# and put the result in backend/.env as WHATSAPP_API_TOKEN.
WHATSAPP_SECRET_KEY=REPLACE_WITH_openssl_rand_hex_24

# Firebase web config — inlined into the frontend bundle at BUILD time.
# Changing any of these requires: docker compose up -d --build frontend
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ticketfox-web.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ticketfox-web
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ticketfox-web.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=595371367509
NEXT_PUBLIC_FIREBASE_APP_ID=1:595371367509:web:145077a5f7f134f76fc8dc

# Admin identity — MUST match ADMIN_EMAIL / ADMIN_UID in backend/.env,
# otherwise the admin dashboard locks the account out.
NEXT_PUBLIC_ADMIN_EMAIL=saisandeepy456@gmail.com
NEXT_PUBLIC_ADMIN_UID=1tXP1wmqmgXhVZvOiIgDL5L8sm03

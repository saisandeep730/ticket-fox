# TicketFox — backend environment (copy to ./backend/.env)
#
# Read by the backend container via docker-compose `env_file`.
# chmod 600 backend/.env after filling this in.
#
# NOTE: docker-compose.yml overrides DEBUG, ALLOW_MOCK_AUTH, DATABASE_URL,
# WHATSAPP_API_URL, PUBLIC_APP_URL and CORS_ORIGINS for container networking.
# The values here keep the file self-consistent and safe if run outside Docker.

# ---------------------------------------------------------------- API server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# SQLite on the mounted volume. Four slashes = absolute path.
DATABASE_URL=sqlite+aiosqlite:////data/ticket_fox_web.db

# ---------------------------------------------------------------------- auth
# Production: real Firebase token verification, no demo sign-in.
ALLOW_MOCK_AUTH=false

# Path is resolved relative to /app inside the container. The file is bind-mounted
# by docker-compose.yml, so the filename here must match the mount target exactly.
FIREBASE_CREDENTIALS_PATH=ticketfox-web-firebase-adminsdk-fbsvc-a0fa60b1fd.json
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=ticketfox-web

# Generate with: openssl rand -hex 32
SECRET_KEY=REPLACE_WITH_openssl_rand_hex_32

# ---------------------------------------------------------------------- CORS
# Comma-separated. Keep every origin the browser can legitimately load from.
CORS_ORIGINS=https://ticketfox.site,https://www.ticketfox.site

# -------------------------------------------------------------------- worker
WORKER_ENABLED=true
POLL_INTERVAL_SECONDS=180
WORKER_CONCURRENCY=3

# --------------------------------------------------------------------- admin
# MUST match NEXT_PUBLIC_ADMIN_EMAIL / NEXT_PUBLIC_ADMIN_UID in ./.env
ADMIN_UID=
ADMIN_EMAIL=

# ------------------------------------------------------------------- scraper
IMPERSONATE=safari18_0

# --------------------------------------------------------------------- email
# Resend's shared sender (onboarding@resend.dev) only delivers to the Resend
# account owner's own verified address. To email arbitrary users, verify a real
# domain in Resend (add the SPF + DKIM + MX records it shows) and change
# RESEND_FROM to e.g. TicketFox <alerts@ticketfox.site>.
RESEND_API_KEY=
RESEND_FROM=TicketFox <alerts@ticketfox.site>

# Per-purpose senders. Resend authorises the DOMAIN, not individual mailboxes, so
# all of these work off the same API key and the same DKIM record — adding one
# needs no extra DNS verification. Each falls back to RESEND_FROM when unset.
RESEND_ALERTS_FROM=TicketFox Alerts <alerts@ticketfox.site>
RESEND_SUPPORT_FROM=TicketFox Support <support@ticketfox.site>
RESEND_GENERAL_FROM=TicketFox <hello@ticketfox.site>

# Branded auth emails (password reset + email verification). The backend mints
# the Firebase action link and sends its own HTML through Resend, so the mail is
# on-brand instead of Firebase's default template. AUTH_EMAIL_FROM must be an
# address on a Resend-verified domain; it falls back to RESEND_FROM when unset.
AUTH_EMAIL_FROM=TicketFox <noreply@ticketfox.site>
AUTH_EMAIL_ENABLED=true

# The human-monitored inbox. Alert and auth mail sets this as Reply-To so a user
# who hits "Reply" reaches a person instead of a send-only mailbox. This is a
# RECEIVING address: it needs a real mailbox (MX + IMAP/webmail). Resend only
# sends — it cannot receive, so this must be provisioned separately.
SUPPORT_EMAIL=support@ticketfox.site

# Optional SMTP fallback (takes precedence over Resend when SMTP_HOST is set).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ------------------------------------------------------------------ whatsapp
# Inside Docker the gateway is reachable by service name, not localhost.
WHATSAPP_API_URL=http://wppconnect:21465
WHATSAPP_SESSION=ticketfox
WHATSAPP_PHONE_FORMAT=array
# Minted by deploy/whatsapp-link.sh from WHATSAPP_SECRET_KEY in ./.env.
# Leave empty until the stack is running, then paste the token in.
WHATSAPP_API_TOKEN=

# ---------------------------------------------------------------------- tmdb
TMDB_API_KEY=

# ----------------------------------------------------------------- public url
# Used in alert email/WhatsApp links. Compose also sets this from DOMAIN.
PUBLIC_APP_URL=https://ticketfox.site
